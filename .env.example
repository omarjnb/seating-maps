# Copy to .env (local) or paste these into your host's environment variables.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Admin password, stored as a hash. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as h; print(h(input('password: ')))"
ADMIN_PASSWORD_HASH=

# Plain-text fallback for quick local testing only. Leave blank in production.
ADMIN_PASSWORD=

# MUST point at a persistent volume in production, or uploads are lost on every
# redeploy. Locally, ./data is fine.
DATA_DIR=./data

# Largest single upload batch, in megabytes.
MAX_UPLOAD_MB=64

# Set to "development" only on your own machine: enables the debugger and
# allows cookies over plain HTTP.
# FLASK_ENV=development
